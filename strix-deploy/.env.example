# ===== Strix 设备端服务配置 =====
# 复制为 .env 后填写。切勿把真实值提交进 git。

# 访问令牌：站点 launcher 投递任务时携带，必须够长够随机
STRIX_TOKEN=change-me-to-a-long-random-token-min-32-chars

# 智谱 API Key（GLM-5.3-Flash）。也可在站点 launcher 每次任务单独传 apiKey
ZHIPU_API_KEY=your-zhipu-api-key

# 服务监听端口（容器与宿主机均映射此端口）
PORT=8787

# Strix 镜像（保持默认即可）
STRIX_IMAGE=usestrix/strix:latest

# 是否用 Docker 沙箱跑 Strix（推荐 true；false 则改用 npx，需容器内有 node/npx）
USE_DOCKER=true

# 单次扫描超时（秒），默认 1800（30 分钟）
RUN_TIMEOUT=1800

# 宿主仓库目录：挂进容器的 /repos，供 Strix 读源码。
# 站点 launcher 的 repo 填 /repos/xxx 这类容器内路径。
REPO_HOST_DIR=./repos
